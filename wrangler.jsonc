// الرافعية on Cloudflare Workers (free plan): a static site in its own Worker named "rafaya",
// separate from every other game. Cloudflare builds it from the repository root on every push to main
// and serves it at https://rafaya.vamosx.workers.dev
{
  "name": "rafaya",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": false,
  // Copy just the game (index.html, icon, css, js, vendor/three.js) into dist/site before each deploy.
  "build": { "command": "node scripts/copy-site.mjs" },
  // The game's files, served as they are; /api/* goes to the Worker below (leaderboard, visits).
  "main": "src/worker.js",
  "assets": { "directory": "./dist/site", "binding": "ASSETS", "run_worker_first": ["/api/*", "/", "/index.html", "/sw.js", "/manifest.webmanifest"] },
  // One Durable Object with SQLite storage keeps the published towns and their comments (free plan).
  "durable_objects": { "bindings": [{ "name": "BOARD", "class_name": "Board" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Board"] }]
}
